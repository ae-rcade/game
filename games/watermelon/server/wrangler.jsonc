{
  // name은 Cloudflare 대시보드의 Worker 이름과 같아야 배포돼요.
  "name": "ae-rcade-watermelon",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "RANKING", "class_name": "Ranking" }]
  },
  "exports": {
    "Ranking": { "type": "durable-object", "storage": "sqlite" }
  },
  // 랭킹을 등록할 수 있는 사이트 주소 (쉼표로 여러 개)
  "vars": { "ALLOWED_ORIGINS": "https://ae-rcade.github.io" }
}
