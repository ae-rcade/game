{
  // name은 Cloudflare 대시보드의 Worker 이름과 같아야 배포돼요.
  "name": "ae-rcade-lyrics",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "GATE", "class_name": "Gate" }
    ]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" },
    "Gate": { "type": "durable-object", "storage": "sqlite" }
  },
  // 접속할 수 있는 사이트 주소 (쉼표로 여러 개)
  "vars": { "ALLOWED_ORIGINS": "https://ae-rcade.github.io" }
}
